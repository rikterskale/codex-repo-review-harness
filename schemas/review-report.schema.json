{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Repository Review Report",
  "type": "object",
  "required": ["schema_version", "status", "summary", "findings", "metadata"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["passed", "findings", "blocked", "failed"] },
    "summary": { "type": "string", "maxLength": 20000 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "location", "evidence", "suggested_fix"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "title": { "type": "string", "maxLength": 500 },
          "location": { "type": "string", "maxLength": 1000 },
          "evidence": { "type": "string", "maxLength": 5000 },
          "suggested_fix": { "type": "string", "maxLength": 5000 }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "required": ["repository", "commit", "generated_at", "failure_class"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string" },
        "generated_at": { "type": "string" },
        "failure_class": { "enum": ["none", "usage", "prerequisite", "timeout", "output_limit", "codex", "contract", "blocked"] },
        "failure_detail": { "type": "string", "maxLength": 5000 }
      }
    }
  },
  "additionalProperties": false
}
